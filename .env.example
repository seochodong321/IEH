# ── 인천 행사 상황판 환경변수 ──
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 커밋되지 않습니다)

# 관리자 비밀번호 — 행사 등록/수정/삭제에 사용.
# 운영(배포) 환경에서는 반드시 설정해야 하며, 미설정 시 로그인이 거부됩니다.
# 로컬 개발에서만 미설정 시 기본값 "admin1234" 가 사용됩니다.
ADMIN_PASSWORD=admin1234

# 세션 토큰 서명용 비밀키 (운영 환경 설정 권장).
# 설정하면 세션 쿠키가 이 값 없이는 재계산될 수 없게 됩니다.
# 생성 예: openssl rand -hex 32
SESSION_SECRET=

# Neon(Postgres) 연결 문자열.
# - Vercel에서 Neon을 연동하면 자동으로 주입되므로 직접 설정할 필요가 없습니다.
# - 로컬에서 실제 DB로 테스트하려면 여기에 연결 문자열을 넣으세요.
# - 비워두면 앱은 내장 샘플 데이터(시드 모드)로 동작합니다.
DATABASE_URL=
